{
  "name": "yokailabs-configs",
  "private": true,
  "version": "0.0.1",
  "description": "Shared configuration packages for Yokai Labs (Prettier, ESLint, tsconfig, etc.), managed via npm workspaces.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "prettier": "@yokailabs/prettier-config",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9"
  },
  "scripts": {
    "changeset": "changeset",
    "fmt:check": "prettier . --check",
    "fmt": "prettier . --write",
    "release": "changeset version && changeset publish",
    "ws:list": "npm query .workspace",
    "ws:versions": "npm ls -ws --depth=0",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yokai-Lab/yokailabs-configs.git"
  },
  "bugs": {
    "url": "https://github.com/Yokai-Lab/yokailabs-configs/issues"
  },
  "homepage": "https://github.com/Yokai-Lab/yokailabs-configs#readme",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10",
  "lint-staged": {
    "*.{js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  }
}
