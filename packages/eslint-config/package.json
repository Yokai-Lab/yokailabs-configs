{
  "name": "@yokailabs/eslint-config",
  "version": "0.2.0",
  "description": "Shared ESLint flat configs for Yokai Labs TypeScript projects: base, Node, and Vite + React.",
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "config",
    "yokailabs",
    "node",
    "react",
    "typescript"
  ],
  "author": "YokaiLabs, LLP.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./base": "./base.js",
    "./node": "./node.js",
    "./react": "./react.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "base.js",
    "node.js",
    "react.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "eslint": "^9",
    "prettier": ">=3",
    "typescript": ">=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yokai-Lab/yokailabs-configs.git",
    "directory": "packages/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/Yokai-Lab/yokailabs-configs/issues"
  },
  "homepage": "https://github.com/Yokai-Lab/yokailabs-configs#readme",
  "devDependencies": {
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.1"
  }
}
